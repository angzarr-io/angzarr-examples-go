# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
*/*/agg-*
*/*/saga-*
*/*/pmg-*
*/*/prj-*
# Root-level service binaries built by `just build` / `go build .`. Each cmd
# package emits an executable here; never commit them.
/agg
/upc
/saga-*
/pmg-*
/prj-*

# Test binary
*.test

# Output
*.out

# Go build cache (set via GOCACHE=.gocache when running outside the container)
.gocache/

# Pending-scenario tracking file emitted by `tests/...` runs
.pending_hand.txt

# Dependency directories
vendor/

# Go workspace file
go.work

# Generated proto code
proto/**/*pb.go

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Kubernetes
*.kubeconfig

# Mutation testing
.mutants-cache/
mutation-results/
mutants-reports/
