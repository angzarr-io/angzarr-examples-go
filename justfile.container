# Go examples - container version
# This file is mounted as 'justfile' inside the container
# Also used directly in CI container jobs
#
# Go recipes are no-ops until the repo has a go.mod (the blackjack
# example port adds one).

set shell := ["bash", "-c"]

ROOT := `git rev-parse --show-toplevel`

default:
    @just --list

# Run a command when the repo has a Go module; skip otherwise
[private]
_go +ARGS:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -f "{{ROOT}}/go.mod" ]; then
        echo "No Go module yet; skipping '{{ARGS}}'"
        exit 0
    fi
    cd "{{ROOT}}" && {{ARGS}}

# Generate protos for client library (required before build)
proto-gen: (_go "buf" "generate")

build: proto-gen (_go "go" "build" "./...")

test-unit: proto-gen (_go "go" "test" "-v" "./..." "-timeout=120s")

test-acceptance: proto-gen (_go "go" "test" "-v" "-tags=acceptance" "./..." "-timeout=600s")

test: test-unit test-acceptance

fmt: (_go "gofmt" "-w" ".")

lint: (_go "golangci-lint" "run")
